rules_version = '2';

// Paste into Firebase console > Firestore Database > Rules.
// Role source of truth: staff/{uid} doc, where {uid} is the person's Firebase
// Auth uid (see db.js DB.createStaffAuthAccount). The bootstrap Owner account
// (owner@didi-malatang.local) is trusted unconditionally so the shop can never get
// locked out even before its staff doc exists.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerEmail() {
      return isSignedIn() && request.auth.token.email == 'owner@didi-malatang.local';
    }

    function myStaff() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    function myRole() {
      return myStaff().role;
    }

    // Whether the caller's own end date (ลาออก) is in the past. Parsed rather
    // than string-compared: rules have no reliable way to format request.time
    // back into a 'YYYY-MM-DD' string, so the stored date is split into parts
    // and rebuilt as a timestamp. Both sides are UTC midnight, which at UTC+7
    // means access lapses a few hours after local midnight — erring toward
    // letting someone finish a shift, never toward locking them out early.
    function endDatePassed() {
      return 'endDate' in myStaff()
        && myStaff().endDate != null
        && timestamp.date(
             int(myStaff().endDate.split('-')[0]),
             int(myStaff().endDate.split('-')[1]),
             int(myStaff().endDate.split('-')[2])
           ) < request.time.date();
    }

    // Archiving a staff member keeps their doc — that doc is what makes them
    // still visible in the past months they worked — so unlike the old hard
    // delete it does not implicitly revoke access: the role lookup above still
    // succeeds. Without this check an archived person would keep full
    // server-side access, a strict regression, which is why this and the
    // client-side staffHasAppAccess() must ship together. The stored active
    // flag alone isn't trusted: it's written at archive time and goes stale the
    // day after an end date set in the future, so the date is re-checked too.
    function isActiveStaff() {
      return myStaff().active != false && !endDatePassed();
    }

    function roleRank(role) {
      return role == 'App Owner' ? 4 : role == 'Admin' ? 3 : role == 'Manager' ? 2 : role == 'Employee' ? 1 : 0;
    }

    function roleAtLeast(minRole) {
      return isSignedIn() && (isOwnerEmail() || (isActiveStaff() && roleRank(myRole()) >= roleRank(minRole)));
    }

    match /staff/{staffId} {
      allow read: if isSignedIn();
      // Managers can only create Employee/Manager profiles (the Timesheet
      // page's "Add employee" form) and never set a nonzero pay rate on
      // creation — the UI already omits that field for Managers, this is the
      // server-side backstop. Admin/Owner can create any role, any rate (the
      // Admin page's account form). Without the role split a Manager could
      // craft a raw write to self-promote to Admin/Owner.
      allow create: if isOwnerEmail()
        || roleAtLeast('Admin')
        || (roleAtLeast('Manager') && request.resource.data.role in ['Employee', 'Manager'] && request.resource.data.dailyRate == 0);
      // Managers may only edit/remove Employee-role profiles, and can never
      // change dailyRate — salary is Admin+ only to view or edit (Financial
      // tab), even though Managers otherwise manage Employee profiles day to
      // day. Admin/Owner can touch anyone except demoting/removing the App Owner.
      allow update: if isOwnerEmail()
        || (roleAtLeast('Admin') && resource.data.role != 'App Owner')
        || (roleAtLeast('Manager') && resource.data.role == 'Employee' && request.resource.data.dailyRate == resource.data.dailyRate);
      allow delete: if isOwnerEmail()
        || (roleAtLeast('Admin') && resource.data.role != 'App Owner')
        || (roleAtLeast('Manager') && resource.data.role == 'Employee');
    }

    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if roleAtLeast('Manager');
    }

    match /warehouseItems/{itemId} {
      allow read: if isSignedIn();
      // Any signed-in staff can update an item (used for the quantity-restock
      // control everyone sees); only Manager+ create/delete items.
      allow create, delete: if roleAtLeast('Manager');
      allow update: if isSignedIn();
    }

    match /warehouseLogs/{logId} {
      allow read: if isSignedIn();
      // Written alongside every warehouseItems quantity update, including by
      // Employees now — see above. Append-only in practice (no update/delete
      // call site), so those stay Manager+ as a safe default.
      allow create: if isSignedIn();
      allow update, delete: if roleAtLeast('Manager');
    }

    match /routines/{routineId} {
      allow read: if isSignedIn();
      // Any signed-in staff can update lastInspectedAt/lastInspectedImageUrl
      // by uploading an inspection photo; only Manager+ create/delete routines.
      allow create, delete: if roleAtLeast('Manager');
      allow update: if isSignedIn();
    }

    match /routineInspections/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if roleAtLeast('Manager');
    }

    match /notifications/{noteId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /holidays/{holidayId} {
      allow read: if isSignedIn();
      allow write: if roleAtLeast('Admin');
    }

    match /fixedCosts/{monthId} {
      allow read: if isSignedIn();
      allow write: if roleAtLeast('Admin');
    }
  }
}
